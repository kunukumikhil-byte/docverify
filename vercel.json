{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "includeFiles": "models/ai_detector.joblib",
      "excludeFiles": "{tests/**,**/*.test.py,train_ai_detector.py,requirements-train.txt,colab_train.ipynb,static/**,data/**}"
    }
  }
}
